# Tous les fichiers du projet sont en UTF-8 (sans BOM), fins de ligne LF.
# Évite qu'un éditeur Windows n'enregistre en Windows-1252 et ne corrompe les accents.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
